{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portrait-autorig/vendor/portrait-composer/portrait-assembly-v0.2.schema.json",
  "title": "Portrait Assembly Bundle v0.2",
  "description": "Vendored input contract from portrait-composer; unknown extension fields remain allowed.",
  "x-upstream": {
    "vendor": "portrait-composer",
    "commit": "682f25e",
    "schema_id": "portrait-assembly-v0.2"
  },
  "type": "object",
  "required": ["format", "version", "assets", "instances", "composition"],
  "properties": {
    "format": {"const": "portrait-assembly"},
    "version": {"const": "0.2"},
    "assets": {"type": "object"},
    "instances": {"type": "object"},
    "composition": {
      "type": "object",
      "required": ["draw_order", "canvas"],
      "properties": {
        "draw_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "canvas": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0},
            "coordinate_system": {"const": "top-left-y-down"},
            "color_space": {"const": "srgb"},
            "alpha": {"const": "straight"}
          }
        }
      }
    }
  }
}
